{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/coverage",
      "!**/node_modules",
      "!src/ui/frontend/src/components/ui",
      "!docs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["src/ui/frontend/**"],
      "javascript": {
        "formatter": {
          "quoteStyle": "double"
        }
      },
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "warn",
            "useExhaustiveDependencies": "warn"
          },
          "suspicious": {
            "noExplicitAny": "warn",
            "noArrayIndexKey": "warn"
          },
          "style": {
            "noNonNullAssertion": "warn"
          },
          "a11y": {
            "useButtonType": "warn",
            "noSvgWithoutTitle": "warn",
            "useKeyWithClickEvents": "warn",
            "noStaticElementInteractions": "warn"
          }
        }
      }
    },
    {
      "includes": ["test/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
